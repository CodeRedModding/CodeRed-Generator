{
    "version": 3,
    "configurePresets": [
        {
            "name": "windows-x64",
            "displayName": "Windows x64",
            "generator": "Visual Studio 17 2022",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "windows-x86",
            "displayName": "Windows x86",
            "generator": "Visual Studio 17 2022",
            "architecture": "Win32",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "wine-x64",
            "displayName": "Wine x64 (clang-cl through msvc-wine)",
            "generator": "Ninja Multi-Config",
            "toolchainFile": "${sourceDir}/cmake/toolchains/msvc-wine-clang-cl-x64.cmake",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_CONFIGURATION_TYPES": "Release;Debug"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "wine-x86",
            "displayName": "Wine x86 (clang-cl through msvc-wine)",
            "generator": "Ninja Multi-Config",
            "toolchainFile": "${sourceDir}/cmake/toolchains/msvc-wine-clang-cl-x86.cmake",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_CONFIGURATION_TYPES": "Release;Debug"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "windows-x64-release",
            "configurePreset": "windows-x64",
            "configuration": "Release"
        },
        {
            "name": "windows-x64-debug",
            "configurePreset": "windows-x64",
            "configuration": "Debug"
        },
        {
            "name": "windows-x86-release",
            "configurePreset": "windows-x86",
            "configuration": "Release"
        },
        {
            "name": "windows-x86-debug",
            "configurePreset": "windows-x86",
            "configuration": "Debug"
        },
        {
            "name": "wine-x64-release",
            "configurePreset": "wine-x64",
            "configuration": "Release"
        },
        {
            "name": "wine-x64-debug",
            "configurePreset": "wine-x64",
            "configuration": "Debug"
        },
        {
            "name": "wine-x86-release",
            "configurePreset": "wine-x86",
            "configuration": "Release"
        },
        {
            "name": "wine-x86-debug",
            "configurePreset": "wine-x86",
            "configuration": "Debug"
        }
    ]
}
